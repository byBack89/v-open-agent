{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(python -m ruff:*)",
      "Bash(ruff:*)",
      "Bash(python -m mypy:*)",
      "Bash(mypy:*)",
      "Bash(pyright:*)",
      "Bash(scripts/build.sh)",
      "Bash(scripts/dev.sh)",
      "Bash(scripts/dev.sh pytest:*)",
      "Bash(docker compose config:*)"
    ],
    "ask": [
      "Bash(pip install:*)",
      "Bash(python -m pip install:*)",
      "Bash(uv add:*)",
      "Bash(uv pip install:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(huggingface-cli download:*)",
      "Bash(hf download:*)",
      "Bash(git push:*)",
      "Bash(wget:*)"
    ]
  }
}
