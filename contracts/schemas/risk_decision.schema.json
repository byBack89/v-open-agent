{
  "$defs": {
    "Alert": {
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Alert Id",
          "type": "string"
        },
        "delivery_state": {
          "enum": [
            "queued",
            "sent",
            "received",
            "played",
            "expired",
            "unknown_delivery"
          ],
          "title": "Delivery State",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "text_kind": {
          "enum": [
            "approved_template",
            "validated_explanation"
          ],
          "title": "Text Kind",
          "type": "string"
        },
        "valid_until_utc": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until Utc"
        }
      },
      "required": [
        "alert_id",
        "text",
        "text_kind",
        "delivery_state"
      ],
      "title": "Alert",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alert": {
      "anyOf": [
        {
          "$ref": "#/$defs/Alert"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "decided_at_utc": {
      "format": "date-time",
      "title": "Decided At Utc",
      "type": "string"
    },
    "device_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Device Id",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "fixture_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixture Note"
    },
    "model_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Model Versions",
      "type": "object"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "previous_state": {
      "anyOf": [
        {
          "enum": [
            "clear",
            "candidate",
            "warning",
            "unknown",
            "resolved"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous State"
    },
    "reason_codes": {
      "items": {
        "enum": [
          "condition_observed",
          "temporal_confirmation_passed",
          "condition_absent_confirmed",
          "episode_closed",
          "input_stale",
          "quality_blocked",
          "track_lost",
          "sensor_down",
          "fresh_evidence_returned"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "risk_event_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Risk Event Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Session Id",
      "type": "string"
    },
    "severity": {
      "anyOf": [
        {
          "enum": [
            "notice",
            "attention"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Severity"
    },
    "state": {
      "enum": [
        "clear",
        "candidate",
        "warning",
        "unknown",
        "resolved"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "risk_event_id",
    "session_id",
    "device_id",
    "scenario_id",
    "policy_version",
    "state",
    "evidence_ids",
    "reason_codes",
    "decided_at_utc"
  ],
  "title": "RiskDecision",
  "type": "object"
}
